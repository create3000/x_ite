  <Scene>
    <ProtoDeclare name='ColorScheme'>
      <ProtoInterface>
        <field accessType='outputOnly' type='SFBool' name='light'/>
        <field accessType='outputOnly' type='SFBool' name='dark'/>
      </ProtoInterface>
      <ProtoBody>
        <Script DEF='ColorSchemeScript'>
          <field accessType='outputOnly' type='SFBool' name='light'/>
          <field accessType='outputOnly' type='SFBool' name='dark'/>
          <IS>
            <connect nodeField='light' protoField='light'/>
            <connect nodeField='dark' protoField='dark'/>
          </IS>
<![CDATA[ecmascript:

function initialize ()
{
   const colorScheme = window .matchMedia ("(prefers-color-scheme: light)");

   colorScheme .addEventListener ("change", event => changeColorScheme (event));

   changeColorScheme (colorScheme);
}

function changeColorScheme (event)
{
   light = event .matches;

   if (typeof $ !== "undefined")
   {
      if ($("html") .attr ("data-mode") === "light")
         light = true;

      if ($("html") .attr ("data-mode") === "dark")
         light = false;
   }

   dark = !light;
}
]]>
        </Script>
      </ProtoBody>
    </ProtoDeclare>
    <ProtoInstance name='ColorScheme' DEF='_1'/>
    <Background DEF='White'
        skyColor='1 1 1'/>
    <Background DEF='Black'/>
    <EnvironmentLight DEF='CannonExterior'>
      <ImageCubeMapTexture containerField='specularTexture'
          url='"../images/cannon-exterior.avif", "../images/cannon-exterior.jpg"'/>
    </EnvironmentLight>
    <Viewpoint
        position='0 -0.5130038 8.320494'
        centerOfRotation='0 -0.5130038 0'/>
    <Transform DEF='Logo'
        scale='3.991387 3.991387 3.991387'>
      <Inline
          url='"gltf_logo.glb"'/>
    </Transform>
    <Transform DEF='Text_1'
        translation='0 -2.9167 0'
        scale='0.68 0.68 0.68'>
      <FontLibrary
          family='Suissnord'
          url='"suissnord.regular.otf"'/>
      <Shape DEF='Light'
          visible='false'>
        <Appearance>
          <UnlitMaterial
              emissiveColor='0 0 0'/>
        </Appearance>
        <Text DEF='_2'
            string='"Sample Viewer"'>
          <FontStyle
              family='"Suissnord", "SANS"'
              justify='"MIDDLE", "MIDDLE"'/>
        </Text>
      </Shape>
      <Shape DEF='Dark'>
        <Text USE='_2'/>
      </Shape>
    </Transform>
    <ROUTE fromNode='_1' fromField='light' toNode='Light' toField='set_visible'/>
    <ROUTE fromNode='_1' fromField='light' toNode='White' toField='set_bind'/>
    <ROUTE fromNode='_1' fromField='dark' toNode='Dark' toField='set_visible'/>
    <ROUTE fromNode='_1' fromField='dark' toNode='Black' toField='set_bind'/>
